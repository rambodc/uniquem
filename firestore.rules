rules_version = '2';
// Closed to the browser. Every read and write goes through Cloud Functions, which check access first
// (functions/core.js requireMiniApp / requireSuperAdmin). That includes the Safety mini app: safetyCategories,
// safetyLessons (whose quiz answers must never reach the browser) and safetyProgress (each person's own record).
service cloud.firestore { match /databases/{database}/documents { match /{document=**} { allow read, write: if false; } } }
